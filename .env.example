# ---------------------------------------------------------------------------
# FOGROOM environment configuration
# Copy to `.env` (repo root) and adjust. Never commit a real `.env`.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (async driver). Docker compose maps Postgres to host port 5432.
DATABASE_URL=postgresql+asyncpg://fogroom:fogroom@localhost:5432/fogroom
# Separate database used by the pytest suite (created by infra/docker/postgres/init.sql)
TEST_DATABASE_URL=postgresql+asyncpg://fogroom:fogroom@localhost:5432/fogroom_test

REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

# JWT - generate a long random value for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo mode enables one-click demo logins for the seeded accounts.
# Disable (false) for any shared / deployed environment.
DEMO_MODE=true
# Password given to every seeded demo account by `make seed`.
DEMO_PASSWORD=FogRoom!2026

# Scenario engine background loop (disable only for debugging)
ENGINE_AUTORUN=true
ENGINE_TICK_SECONDS=1.0

# Optional: enables AI-written AAR narratives. Without it a deterministic
# template narrative is used. Historical events are never modified by AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Frontend (Next.js) - read at build/dev time
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
